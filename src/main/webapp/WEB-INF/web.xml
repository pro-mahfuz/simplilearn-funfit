<?xml version="1.0" encoding="UTF-8"?>

<web-app 
    xmlns="http://xmlns.jcp.org/xml/ns/javaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://xmlns.jcp.org/xml/ns/javaee
        http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
    version="4.0">


    <display-name>FunFit Gym Management</display-name>


    <!-- Participant Servlet -->

    <servlet>

        <servlet-name>ParticipantServlet</servlet-name>

        <servlet-class>
            com.funfit.servlet.ParticipantServlet
        </servlet-class>

    </servlet>


    <servlet-mapping>

        <servlet-name>ParticipantServlet</servlet-name>

        <url-pattern>/participant</url-pattern>

    </servlet-mapping>



    <!-- Batch Servlet -->

    <servlet>

        <servlet-name>BatchServlet</servlet-name>

        <servlet-class>
            com.funfit.servlet.BatchServlet
        </servlet-class>

    </servlet>


    <servlet-mapping>

        <servlet-name>BatchServlet</servlet-name>

        <url-pattern>/batch</url-pattern>

    </servlet-mapping>



    <!-- Welcome Page -->

    <welcome-file-list>

        <welcome-file>index.html</welcome-file>

    </welcome-file-list>


</web-app>